   "y": 1150
  },
  {
   "type": "source",
   "t0": 19.799999999999997,
   "t1": 53.0,
   "text": "السودان بودكاست – 6 نوفمبر 2026 | ترجمة إلى الفصحى",
   "y": 1680
  },
  {
   "type": "kicker",
   "t0": 53.599999999999994,
   "t1": 67.0,
   "text": "من هو أحمد هارون؟",
   "y": 200
  },
  {
   "type": "card",
   "t0": 54.099999999999994,
   "t1": 67.0,
   "year": "2007",
   "text": "وزير دولة بالداخلية حين صدرت بحقه مذكرة توقيف من المحكمة الجنائية الدولية",
   "y": 360
  },
  {
   "type": "card",
   "t0": 56.099999999999994,
   "t1": 67.0,
   "year": "2019",
   "text": "اعتُقل بعد سقوط نظام البشير",
