  },
  {
   "type": "card",
   "t0": 60.099999999999994,
   "t1": 67.0,
   "year": "يناير 2024",
   "text": "واشنطن تعرض مكافأة تصل إلى 5 ملايين دولار مقابل معلومات عنه",
   "y": 1065
  },
  {
   "type": "card",
   "t0": 62.099999999999994,
   "t1": 67.0,
   "year": "نوفمبر 2026",
   "text": "مقابلة مطوّلة مع السودان بودكاست.. ثم إعلان اعتقاله",
   "y": 1300
  },
  {
   "type": "source",
   "t0": 54.099999999999994,
   "t1": 67.0,
