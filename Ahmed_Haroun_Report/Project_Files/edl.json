 "subs": [
  {
   "start": 0.55,
   "end": 3.73,
   "text": "الأمريكان يُرونك اللبن.. ويُعشّونك بالماء"
  },
  {
   "start": 19.61,
   "end": 24.07,
   "text": "ليست لدينا علاقة عضوية بـ(الفريق البرهان)"
  },
  {
   "start": 24.53,
   "end": 28.51,
   "text": "لا نشعر بضغينة شخصية تجاهه"
  },
  {
   "start": 28.91,
   "end": 37.47,
   "text": "البعض يحاول تصوير الأمر وكأنه غطاء لعلاقة أخرى.. بحبل سري"
  },
  {
   "start": 37.9,
   "end": 40.45,
   "text": "هذا ليس صحيحاً"
  },
  {
   "start": 40.91,
   "end": 45.76,
   "text": "العلاقة هي علاقة أناس توحّدوا في ميدان المعركة"
  },
  {
   "start": 46.18,
   "end": 48.98,
   "text": "ليس بالضرورة أن نكون متفقين في بقية الأمور.."
  },
  {
   "start": 49.31,
   "end": 53.04,
   "text": "في الأداء السياسي والتنفيذي والاقتصادي"
  }
 ],
 "graphics": [
  {
   "type": "kicker",
   "t0": 0.3,
   "t1": 7.2,
   "text": "تقرير خاص | صحيفة ألوان السودانية",
   "y": 190
  },
  {
   "type": "headline",
   "t0": 0.8,
   "t1": 7.2,
   "text": "أحمد هارون.. ماذا قال قبل اعتقاله؟",
   "y": 380,
   "size": 84
  },
  {
   "type": "source",
   "t0": 0.8,
   "t1": 7.2,
   "text": "المصدر: السودان بودكاست – 6 نوفمبر 2026"
  },
  {
   "type": "kicker",
   "t0": 7.699999999999998,
   "t1": 19.099999999999998,
   "text": "عاجل",
   "y": 190
  },
  {
   "type": "headline",
   "t0": 7.7,
   "t1": 19.099999999999998,
   "text": "اعتقال رئيس المؤتمر الوطني المحلول",
   "y": 350,
   "size": 80
  },
  {
   "type": "body",
   "t0": 9.0,
   "t1": 19.099999999999998,
   "text": "أُعلن في 8 نوفمبر 2026 عن اعتقال أحمد هارون، بحسب ما نقلته رويترز عن مسؤولَين في الحزب",
   "y": 1290,
   "size": 46,
   "w": 700
  },
  {
   "type": "body",
   "t0": 12.4,
   "t1": 19.099999999999998,
   "text": "لم يصدر تعليق فوري من الجيش.. ومصدر أمني لفرانس 24: الاحتجاز تم وفق إجراءات قانونية",
   "y": 1450,
   "size": 40,
   "w": 600,
   "color": [
    216,
    218,
    217
   ]
  },
  {
   "type": "source",
   "t0": 8.0,
   "t1": 19.099999999999998,
   "text": "Reuters | AFP",
   "y": 1680
  },
  {
   "type": "kicker",
   "t0": 19.599999999999998,
   "t1": 53.0,
   "text": "عن علاقة حزبه بالجيش والبرهان",
   "y": 190
  },
  {
   "type": "lower",
   "t0": 19.799999999999997,
   "t1": 25.4,
